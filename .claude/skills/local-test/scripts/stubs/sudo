#!/bin/bash
# Stand-in for a real sudo whose cached login has expired: every call needs the
# password, given via -A (SUDO_ASKPASS) or -S (stdin). A terminal prompt = the old bug.
log=$HOME/sudo-calls.log
askpass=0 stdin=0 nonint=0 validate=0
while [[ ${1:-} == -* ]]; do
  case $1 in -A) askpass=1 ;; -S) stdin=1 ;; -n) nonint=1 ;; -v) validate=1 ;; -k) exit 0 ;; -p) shift ;; --) shift; break ;; esac
  shift
done
if [[ -n ${STUB_NOPASSWD:-} ]]; then pw=secret; how=nopasswd
elif [[ $askpass -eq 1 ]]; then pw=$("$SUDO_ASKPASS"); how=askpass
elif [[ $stdin -eq 1 ]];   then read -r pw; how=stdin
elif [[ $nonint -eq 1 ]];  then echo "nonint-refused $*" >> "$log"; exit 1
else echo "PROMPTED $*" >> "$log"; echo "sudo: a terminal is required to read the password" >&2; exit 1
fi
[[ $pw == secret ]] || { echo "wrong-password($how) $*" >> "$log"; exit 1; }
echo "ok($how) $*" >> "$log"
[[ $validate -eq 1 && $# -eq 0 ]] && exit 0
case ${1:-} in
  pacman) shift; exec pacman "$@" ;;
  tee) cat >/dev/null ;;
  awk) shift; exec awk "$@" ;;
  true) exit 0 ;;
  *) echo "[would run as root] $*"; sleep 0.05 ;;
esac
