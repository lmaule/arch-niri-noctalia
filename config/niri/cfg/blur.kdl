// ────────────── Blur ──────────────
// Needs niri 26.04 or newer: older versions reject these settings, so the
// install script comments out the include for this file in config.kdl.
// Based on CachyOS niri-noctalia settings and Noctalia's niri docs (GPL-3.0).

    // Apps: blur them all without xray so it looks more realistic.
    window-rule {
        background-effect {
          blur true
          xray false
        }
    }

    // Noctalia: disable xray on its surfaces. Noctalia publishes blur regions
    // automatically when ext-background-effects is available.
    layer-rule {
        match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
        background-effect {
          xray false
          // blur false
        }
    }

    // Blur Noctalia's window switcher, without xray.
    layer-rule {
        match namespace="noctalia-window-switcher"
        background-effect {
          blur true
          xray false
        }
    }

    // Fine-tune the blur effect globally.
    blur {
        passes 2        // more passes = stronger blur (default: 3)
        offset 3.0      // sample distance per pass (default: 3.0)
        noise 0.03      // grain overlay (default: 0.02)
        saturation 1.0  // color saturation boost (default: 1.5)
    }

    // To turn Noctalia's blur off entirely, uncomment this
    // (removing the rules above is not enough):
    // layer-rule {
    //     match namespace="^noctalia-"
    //     background-effect {
    //         blur false
    //     }
    // }
